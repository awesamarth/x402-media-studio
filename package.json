{
  "name": "x402-media-studio",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/server.ts",
    "test": "bun test",
    "demo": "bun scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "demo:ai": "bun scripts/demo-local-ai.ts",
    "test:ai": "bun --env-file=.env.local test tests/local-ai.test.ts",
    "setup:local": "bash scripts/install-local.sh",
    "try:file": "bun scripts/try-file.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@x402/core": "2.28.0",
    "zod": "4.4.3"
  }
}
