# Existing ubuntu account. Billing mode comes from .env.local; no customer API key.
[Unit]
Description=X402 Media Studio API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/x402-media-studio
EnvironmentFile=/home/ubuntu/x402-media-studio/.env.local
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=PUBLIC_FREE_DEMO=1
Environment=DATA_DIR=/home/ubuntu/x402-media-studio/data/service
ExecStart=/home/ubuntu/x402-media-studio/.runtime/bin/bun src/server.ts
Restart=on-failure
RestartSec=3
Nice=10
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/x402-media-studio/data/service
UMask=0077
MemoryMax=3G
TasksMax=128

[Install]
WantedBy=multi-user.target
